          ],
          "outputs": [
            "hidden_states",
            "new_key",
            "new_value"
          ]
        },
        "decode": {
          "file": "decoder_layer_decode_1.q.circle",
          "inputs": [
            "hidden_states",
            "attention_mask",
            "past_key",
            "past_value",
            "rope_cos",
            "rope_sin"
          ],
          "outputs": [
            "hidden_states",
