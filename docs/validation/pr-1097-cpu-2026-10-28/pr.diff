+            with self.assertRaisesRegex(ObserverNotReadyError, "fresh calibration"):
+                obs.derive_candidate()
+            obs.reset()
+            obs.collect(torch.tensor([-1.0, 1.0]))
+            self.assertEqual(obs.derive_candidate().provenance, "calibrated")
