+            model.enable_calibration()
+            model(torch.tensor([-1.0, 2.0]))
+            model.freeze_qparams()
+            reference = weakref.ref(model)
+            del model
+            self.assertIsNone(reference())
+        finally:
+            if was_enabled:
+                gc.enable()
