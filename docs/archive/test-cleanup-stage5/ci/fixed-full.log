2026-11-11T02:13:03.4834897Z class Add(torch.nn.Module):
2026-11-11T02:13:03.4835192Z     def forward(self, x, y):
2026-11-11T02:13:03.4835465Z         return x + y
2026-11-11T02:13:03.4835701Z 
2026-11-11T02:13:03.4836038Z model = tico.convert(Add().eval(), (torch.ones(2, 3), torch.ones(2, 3)))
2026-11-11T02:13:03.4836467Z model.save("add.circle")
2026-11-11T02:13:03.4836783Z reloaded = CircleModel.load("add.circle")
2026-11-11T02:13:03.4837180Z assert reloaded.runtime == "reference", reloaded.runtime
2026-11-11T02:13:03.4837910Z out = reloaded(torch.full((2, 3), 2.0), torch.full((2, 3), 3.0))
2026-11-11T02:13:03.4838437Z np.testing.assert_array_equal(out, np.full((2, 3), 5.0, dtype=np.float32))
